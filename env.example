# 复制此文件为 .env 并填入你的配置

# API 基础URL
OPENAI_BASE_URL=https://api.openai.com/v1

# API 密钥
OPENAI_API_KEY=your-api-key-here

# ======== 模型配置 ========
# 必须手动填写，项目不内置默认模型。
SPLIT_MODEL=your-split-model
TRANSLATION_MODEL=your-translation-model

# 可选：未设置 SPLIT_MODEL / TRANSLATION_MODEL 时，使用此模型同时承担断句和翻译
# LLM_MODEL=your-default-model

# 是否把完整字幕请求和模型原始响应写入日志（默认 false，避免隐私泄露）
LOG_RAW_PAYLOADS=false
