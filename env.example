# 复制此文件为 .env 并填入你的配置

# API 基础URL
OPENAI_BASE_URL=https://api.openai.com/v1

# API 密钥
OPENAI_API_KEY=your-api-key-here

# ======== 模型配置 ========
# 断句模型 - 负责将长句分割成适合字幕显示的短句
# 推荐：快速模型，如 gpt-4o-mini
SPLIT_MODEL=gpt-4o-mini

# 翻译模型 - 负责将字幕翻译成目标语言
# 推荐：高质量模型，如 gpt-4o 或 claude-3-sonnet
TRANSLATION_MODEL=gpt-4o

# 兼容性：默认模型 (如果上述模型未设置，将使用此模型)
LLM_MODEL=gpt-4o-mini

# 禁止模型生成推理/思考 token（默认 true）
# OpenAI GPT-5.1+、OpenRouter、DeepSeek V4 和 DashScope 会使用各自的关闭参数
DISABLE_THINKING=true

# 是否把完整字幕请求和模型原始响应写入日志（默认 false，避免隐私泄露）
LOG_RAW_PAYLOADS=false
